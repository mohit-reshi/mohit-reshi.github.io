#!/bin/sh
# Blocks commits whose staged files contain a blocklist term. Needs BLOCKLIST env or blocklist.local.txt.
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
if [ -z "$BLOCKLIST" ] && [ ! -f blocklist.local.txt ]; then
  echo "pre-commit: no blocklist available (set BLOCKLIST or create blocklist.local.txt); refusing to commit." >&2
  exit 1
fi
node tools/validate/leak-check.mjs --staged --require || exit 1
