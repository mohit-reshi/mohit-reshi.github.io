---
import type { Project } from '../lib/projects';
import { getMedia, tagsOf } from '../lib/projects';
import Placeholder from './Placeholder.astro';
import TagChips from './TagChips.astro';
interface Props { project: Project; eager?: boolean }
const { project: p, eager = false } = Astro.props;
const media = getMedia(p);
const kindLabel: Record<string, string> = { report: 'Report', paginated: 'Paginated', app: 'App', pipeline: 'Pipeline' };
const hasVideo = !!media.video;
// still-image preview for cards without a recording: up to four report pages, cycled on hover or focus
const previews = hasVideo ? [] : media.pages.slice(0, 4).map((g) => g.thumb ?? g.src);
---
<article class="card" data-card data-slug={p.slug} data-tags={p.data.tags.join(' ')} data-group={p.data.group} data-cursor={hasVideo || previews.length > 1 ? 'play' : 'view'} data-previews={previews.length > 1 ? JSON.stringify(previews) : undefined}>
  <a class="card__link" href={p.href} aria-label={`${p.data.title}: ${p.data.summary}`} data-preview-link>
    <div class="card__media">
      {media.cover
        ? <img src={media.cover.src} width={media.cover.w || 640} height={media.cover.h || 400} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        : <Placeholder title={p.data.title} seed={p.slug} label={kindLabel[p.data.kind]} kind={p.data.kind} />}
      {hasVideo && <video muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" data-src={media.video} poster={media.poster?.src ?? media.cover?.src}></video>}
      {p.data.sample && <span class="card__badge">Sample</span>}
      {p.data.status === 'live' && <span class="card__badge card__badge--live" style={p.data.sample ? 'left:auto;right:var(--s-3)' : ''}>Live Lab</span>}
    </div>
    <div class="card__body">
      <p class="card__meta">{kindLabel[p.data.kind]} · {p.data.year}{p.data.client_label ? ` · ${p.data.client_label}` : ''}</p>
      <h3 class="card__title">{p.data.title}</h3>
      <p class="card__summary">{p.data.summary}</p>
      <TagChips tags={tagsOf(p)} limit={4} />
    </div>
  </a>
</article>
