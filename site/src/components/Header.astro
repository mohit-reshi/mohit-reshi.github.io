---
import { siteConfig } from '../config';
import { withBase } from '../lib/url';
import LayoutSwitcher from './LayoutSwitcher.astro';
const { current = '' } = Astro.props;
const nav = [
  { key: 'work', label: 'Work', href: withBase('work/') },
  ...(siteConfig.liveLab.enabled ? [{ key: 'live-lab', label: 'Live Lab', href: withBase('live-lab/') }] : []),
  { key: 'apps', label: 'Apps', href: withBase('apps/') },
  { key: 'about', label: 'About', href: withBase('about/') },
];
---
<header class="site-header">
  <LayoutSwitcher />
  <div class="container site-header__row">
    <a class="brand" href={withBase('')} aria-label={`${siteConfig.name}, home`}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="17" width="6" height="12" rx="1.5" fill="var(--viz-2)"/><rect x="13" y="8" width="6" height="21" rx="1.5" fill="var(--accent)"/><rect x="23" y="13" width="6" height="16" rx="1.5" fill="var(--viz-3)"/></svg>
      <span>{siteConfig.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {nav.map((n) => <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-header__tools">
      <span class="clock mono" data-clock data-tz={siteConfig.timeZone} data-label={siteConfig.location} aria-label={`Local time in ${siteConfig.location}`}>{siteConfig.location} · --:-- IST</span>
      {siteConfig.status.show && <span class="status" data-status data-tone={siteConfig.status.tone}>{siteConfig.status.text}</span>}
      <button class="btn btn--ghost" type="button" data-open-palette aria-label="Search the site (Control K)" aria-keyshortcuts="Control+K Meta+K">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="kbd-hint"><kbd>Ctrl</kbd> <kbd>K</kbd></span>
      </button>
      <button class="btn btn--ghost btn--icon" type="button" data-theme-toggle aria-label="Switch colour theme" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <button class="btn btn--ghost" type="button" data-open-info aria-haspopup="dialog" aria-label="Open info panel"><span class="btn-info-label">Info</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/></svg></button>
    </div>
  </div>
</header>
