{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../tools/site/ensure-livelab.mjs && node ../tools/site/sync-media.mjs --drafts && node ../tools/site/make-app-packages.mjs && astro dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "sync": "node ../tools/site/ensure-livelab.mjs && node ../tools/site/sync-media.mjs && node ../tools/site/make-app-packages.mjs",
    "validate": "node ../tools/validate/validate.mjs",
    "leak-check": "node ../tools/validate/leak-check.mjs",
    "contrast": "node ../tools/validate/contrast.mjs",
    "new:project": "node ../tools/scaffold/new-project.mjs",
    "new:app": "node ../tools/scaffold/new-app.mjs",
    "test": "vitest run",
    "check": "astro check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
