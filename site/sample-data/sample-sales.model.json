  "measures": [
    {
      "name": "Revenue",
      "table": "_Measures",
      "display_folder": "Base",
      "format": "#,0",
      "description": "Net revenue after returns.",
      "expression": "SUMX(Fact_Sales, Fact_Sales[Quantity] * Fact_Sales[UnitPrice] - Fact_Sales[Returns])",
      "depends_on": []
    },
    {
      "name": "Revenue LY",
      "table": "_Measures",
      "display_folder": "Time Intelligence",
      "format": "#,0",
      "description": "Same period last year.",
      "expression": "CALCULATE([Revenue], SAMEPERIODLASTYEAR(Dim_Date[Date]))",
      "depends_on": [
        "Revenue"
      ]
    },
    {
      "name": "Revenue YoY %",
      "table": "_Measures",
      "display_folder": "Time Intelligence",
      "format": "0.0%",
      "description": "Growth against last year.",
      "expression": "VAR Prior = [Revenue LY]\nRETURN\n    DIVIDE([Revenue] - Prior, Prior)",
      "depends_on": [
        "Revenue",
        "Revenue LY"
      ]
    },
    {
      "name": "Revenue by Ship Date",
      "table": "_Measures",
      "display_folder": "Alternate dates",
      "format": "#,0",
      "description": "Revenue dated by shipment (inactive relationship).",
      "expression": "CALCULATE([Revenue], USERELATIONSHIP(Fact_Sales[ShipDateKey], Dim_Date[DateKey]))",
      "depends_on": [
        "Revenue"
      ]
    },
    {
      "name": "Selected Metric",
      "table": "_Measures",
      "display_folder": "Metric Selector",
      "format": "#,0",
      "description": "Switches the headline metric from a disconnected table.",
      "expression": "SWITCH(\n    SELECTEDVALUE(Metric_Selector[Metric], \"Revenue\"),\n    \"Revenue\", [Revenue],\n    \"YoY %\", [Revenue YoY %],\n    [Revenue]\n)",
      "depends_on": [
        "Revenue",
        "Revenue YoY %"
      ]
    },
    {
      "name": "Budget Revenue",
      "table": "_Measures",
      "display_folder": "Budget",
      "format": "#,0",
      "description": "Planned revenue.",
      "expression": "SUM(Budget[Amount])",
      "depends_on": []
    },
    {
      "name": "Revenue vs Budget (bps)",
      "table": "_Measures",
      "display_folder": "Budget",
      "format": "0",
      "description": "Variance in basis points.",
      "expression": "DIVIDE([Revenue] - [Budget Revenue], [Budget Revenue]) * 10000",
      "depends_on": [
        "Revenue",
        "Budget Revenue"
      ]
    },
    {
      "name": "Title: Executive",
      "table": "_Measures",
      "display_folder": "Dynamic Titles",
      "format": "@",
      "description": "Headline that follows the selection.",
      "expression": "\"Revenue \" & FORMAT([Revenue], \"#,0\") & \" (\" & FORMAT([Revenue YoY %], \"+0.0%;-0.0%\") & \" YoY)\"",
      "depends_on": [
        "Revenue",
        "Revenue YoY %"
      ]
    }
  ],
