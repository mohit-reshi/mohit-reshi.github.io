  "measures": [
    {
      "name": "Amount",
      "table": "_Measures",
      "display_folder": "Base",
      "format": "#,0",
      "description": "Ledger amount.",
      "expression": "SUM(Fact_Ledger[Amount])",
      "depends_on": []
    },
    {
      "name": "Statement Line",
      "table": "_Measures",
      "display_folder": "Statement",
      "format": "#,0",
      "description": "Evaluates the current template line.",
      "expression": "VAR Line = SELECTEDVALUE('P&L Template'[Line])\nRETURN\n    SWITCH(\n        Line,\n        \"Revenue\", [Amount],\n        \"Gross margin %\", DIVIDE([Amount], [Amount]),\n        [Amount]\n    )",
      "depends_on": [
        "Amount"
      ]
    },
    {
      "name": "Amount PY",
      "table": "_Measures",
      "display_folder": "Year over year",
      "format": "#,0",
      "description": "Prior year amount.",
      "expression": "CALCULATE([Amount], SAMEPERIODLASTYEAR(Dim_Date[Date]))",
      "depends_on": [
        "Amount"
      ]
    },
    {
      "name": "Selected Date",
      "table": "_Measures",
      "display_folder": "Aged receivables",
      "format": "d mmm yyyy",
      "description": "As-of date from the date slicer.",
      "expression": "MIN(Dim_Date[Date])",
      "depends_on": []
    },
    {
      "name": "Days Left",
      "table": "_Measures",
      "display_folder": "Aged receivables",
      "format": "0",
      "description": "Days until due on the as-of date; blank when not open.",
      "expression": "VAR AsOf = [Selected Date]\nRETURN\n    IF(MIN(Fact_Invoices[InvoiceDate]) < AsOf && MIN(Fact_Invoices[DueDate]) > AsOf,\n        DATEDIFF(AsOf, MIN(Fact_Invoices[DueDate]), DAY))",
      "depends_on": [
        "Selected Date"
      ]
    },
    {
      "name": "Receivables",
      "table": "_Measures",
      "display_folder": "Aged receivables",
      "format": "#,0",
      "description": "Open invoice value on the as-of date.",
      "expression": "IF(ISBLANK([Days Left]), BLANK(), SUM(Fact_Invoices[Value]))",
      "depends_on": [
        "Days Left"
      ]
    },
    {
      "name": "Receivables per Band",
      "table": "_Measures",
      "display_folder": "Aged receivables",
      "format": "#,0",
      "description": "Open value inside the selected ageing band.",
      "expression": "CALCULATE([Receivables], FILTER(Fact_Invoices, [Days Left] >= MIN('Aged Bands'[MinDays]) && [Days Left] <= MAX('Aged Bands'[MaxDays])))",
      "depends_on": [
        "Receivables",
        "Days Left"
      ]
    }
  ],
