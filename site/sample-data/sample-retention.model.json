  "measures": [
    {
      "name": "Cases",
      "table": "_Measures",
      "display_folder": "Base",
      "format": "#,0",
      "description": "All cases in the current filter context.",
      "expression": "COUNTROWS(Fact_Cases)",
      "depends_on": []
    },
    {
      "name": "Cases by Termination Date",
      "table": "_Measures",
      "display_folder": "Toggles",
      "format": "#,0",
      "description": "Counts cases by termination date instead of history date.",
      "expression": "CALCULATE([Cases], USERELATIONSHIP(Fact_Cases[TerminationDateKey], Dim_Date[DateKey]))",
      "depends_on": [
        "Cases"
      ]
    },
    {
      "name": "Cases (date basis)",
      "table": "_Measures",
      "display_folder": "Toggles",
      "format": "#,0",
      "description": "Reads the date-basis toggle.",
      "expression": "VAR Basis = SELECTEDVALUE(Param_Date_Basis[Key], 1)\nRETURN\n    SWITCH(Basis, 1, [Cases], 2, [Cases by Termination Date], [Cases])",
      "depends_on": [
        "Cases",
        "Cases by Termination Date"
      ]
    },
    {
      "name": "Recovered %",
      "table": "_Measures",
      "display_folder": "Base",
      "format": "0.0%",
      "description": "Share of terminated cases that were reinstated.",
      "expression": "DIVIDE(CALCULATE([Cases], Fact_Cases[Outcome] = \"Reinstated\"), CALCULATE([Cases], Fact_Cases[Outcome] <> \"Active\"))",
      "depends_on": [
        "Cases"
      ]
    },
    {
      "name": "Alt text: headline",
      "table": "_Measures",
      "display_folder": "Accessibility",
      "format": "@",
      "description": "Alt text that follows the selection.",
      "expression": "\"Cases: \" & FORMAT([Cases (date basis)], \"#,0\") & \", recovered \" & FORMAT([Recovered %], \"0%\")",
      "depends_on": [
        "Cases (date basis)",
        "Recovered %"
      ]
    },
    {
      "name": "Top Reason",
      "table": "_Measures",
      "display_folder": "Base",
      "format": "@",
      "description": "Most frequent termination reason.",
      "expression": "VAR T = TOPN(1, VALUES(Fact_Cases[Reason]), CALCULATE([Cases]))\nRETURN\n    MAXX(T, Fact_Cases[Reason])",
      "depends_on": [
        "Cases"
      ]
    }
  ],
