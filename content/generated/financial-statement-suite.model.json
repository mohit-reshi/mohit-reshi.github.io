  "measures": [
    {
      "name": "Total Revenue",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
      "description": "",
      "expression": "CALCULATE(\n    SUM( 'Profit Loss'[Amount] ),\n    'Profit Loss'[LineType] = \"Revenue\"\n)",
      "depends_on": []
    },
    {
      "name": "Total COGS",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
      "description": "",
      "expression": "CALCULATE(\n    SUM( 'Profit Loss'[Amount] ),\n    'Profit Loss'[LineType] = \"COGS\"\n)",
      "depends_on": []
    },
    {
      "name": "Gross Profit",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
      "description": "",
      "expression": "[Total Revenue] + [Total COGS]\n-- COGS is already negative in the data\n-- Adding a negative number = subtraction",
      "depends_on": [
        "Total Revenue",
        "Total COGS"
      ]
    },
    {
      "name": "Gross Profit %",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "#,0.00%;-#,0.00%;#,0.00%",
      "description": "",
      "expression": "DIVIDE( [Gross Profit], [Total Revenue], 0 )",
      "depends_on": [
        "Gross Profit",
        "Total Revenue"
      ]
    },
    {
      "name": "Total Expenses",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
      "description": "",
      "expression": "CALCULATE(\n    SUM( 'Profit Loss'[Amount] ),\n    'Profit Loss'[LineType] = \"Expense\"\n)",
      "depends_on": []
    },
    {
      "name": "Net Profit",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
      "description": "",
      "expression": "[Gross Profit] + [Total Expenses]\n-- Expenses are negative — same sign convention",
      "depends_on": [
        "Gross Profit",
        "Total Expenses"
      ]
    },
    {
      "name": "Net Profit %",
      "table": "_Measures",
      "display_folder": "Core Revenue and P&L Measures",
      "format": "0.00%;-0.00%;0.00%",
      "description": "",
      "expression": "DIVIDE( [Net Profit], [Total Revenue], 0 )",
      "depends_on": [
        "Net Profit",
        "Total Revenue"
      ]
    },
    {
      "name": "Total Sales",
