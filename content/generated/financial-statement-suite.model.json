      "format": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
      "description": "",
      "expression": "CALCULATE(\n    SUM( 'Cash Flow'[Value] ),\n    'Cash Flow'[CFCategory] = \"Investing Activities\",\n    'Cash Flow'[CFType] = \"Net\"\n)",
