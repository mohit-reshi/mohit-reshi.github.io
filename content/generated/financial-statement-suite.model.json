      "format": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
      "description": "",
      "expression": "CALCULATE(\n    SUM( 'Balance Sheet'[Value] ),\n    'Balance Sheet'[Category] = \"Current Liabilities\"\n)",
